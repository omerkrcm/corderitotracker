# Copy this file to .env.local for local development, and set the same
# values in Vercel's Project Settings → Environment Variables for deploys.
#
# Find these in your Supabase project: Settings → API.
#   SUPABASE_URL              -> "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY -> "service_role" secret key (NOT the anon key)
#
# The service role key bypasses Row Level Security, which is fine here
# because it's only ever used server-side (in Next.js API routes) — it is
# never sent to the browser. Never prefix it with NEXT_PUBLIC_.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
